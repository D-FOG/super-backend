NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/super-citizens
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
UPLOAD_BASE_URL=http://localhost:5000/uploads
LOCAL_UPLOAD_DIR=uploads
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use "zeptomail" in the deployed environment. MAIL_FROM must be a verified
# ZeptoMail sender address and ZEPTO_MAIL_TOKEN must remain server-only.
MAIL_PROVIDER=placeholder
MAIL_FROM=hello@supersitecitizens.org
ZEPTO_MAIL_ENDPOINT=https://api.zeptomail.com/v1.1/email
ZEPTO_MAIL_AUTH_PREFIX=Zoho-enczapikey
ZEPTO_MAIL_TOKEN=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_REDIRECT_URL=http://localhost:3000/payments
FLW_ALLOWED_CURRENCIES=NGN,USD,GBP,EUR
